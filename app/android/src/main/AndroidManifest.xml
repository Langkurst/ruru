<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Paired headphones and earbuds only: no internet. Scanning (Nearby devices) is used to hear
         AirPods and Beats battery adverts and to find a headset's Bluetooth LE address, and is
         declared never for location. Android 11 and older cannot scan without the location
         permission, so that one is asked for there only, and only when a scan is needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Mic check records five seconds from the microphone, only after the person taps it and allows it; nothing is kept. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The equaliser (and later the night schedule) keeps Ruru running with one quiet notification: a foreground
         service of type connectedDevice. Android 13 and newer ask before showing the notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sleep: sounds from the sleep timer play in a foreground service of type mediaPlayback. Wake-up alarms are clock
         alarms (they need no permission); the night's own stages and the night schedule use exact alarms, which an
         alarm app is allowed on Android 13 and newer (USE_EXACT_ALARM) and asks for before that. The phone restarting
         sets every alarm again. The alarm screen opens over a locked phone. No network is used for any of it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RuruApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruru">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the connection and the equaliser alive while a feature needs it (service/RuruService) -->
        <service
            android:name=".service.RuruService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Plays the sleep sounds and rings the alarms (sleep/SleepService) -->
        <service
            android:name=".sleep.SleepService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The alarm screen: over the lock screen, with Stop and Snooze (sleep/AlarmActivity) -->
        <activity
            android:name=".sleep.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Our own alarms going off, and the restart or clock change that means they are set again (sleep/SleepReceiver) -->
        <receiver
            android:name=".sleep.SleepReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Music and video apps hand over their audio session so the equaliser can filter it (eq/) -->
        <receiver
            android:name=".eq.AudioSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
