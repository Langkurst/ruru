<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru（バックグラウンド）</string>
    <string name="notif_channel_description">Ruruがイコライザーまたは夜のスケジュールを動かし続けている間、表示されます。</string>
    <string name="notif_connected">Ruruは%1$sに接続しています</string>
    <string name="notif_waiting">Ruruはヘッドホンを待っています</string>
    <string name="notif_open">開く</string>
    <string name="notif_stop">停止</string>
    <string name="sleep_channel_name">睡眠</string>
    <string name="sleep_channel_description">睡眠タイマーとサウンドの動作中に表示されます。</string>
    <string name="sleep_alarm_channel_name">アラーム</string>
    <string name="sleep_alarm_channel_description">睡眠タブで設定した起床アラームを鳴らします。</string>
    <string name="sleep_notif_sleeping">睡眠タイマー動作中</string>
    <string name="sleep_notif_plus">+%1$d分</string>
    <string name="sleep_notif_alarm">アラーム</string>
    <string name="sleep_notif_snooze">スヌーズ</string>
</resources>
