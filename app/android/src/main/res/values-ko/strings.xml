<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru 백그라운드 실행</string>
    <string name="notif_channel_description">Ruru가 이퀄라이저나 야간 일정을 계속 실행하는 동안 표시됩니다.</string>
    <string name="notif_connected">Ruru가 %1$s에 연결됨</string>
    <string name="notif_waiting">Ruru가 헤드폰을 기다리는 중</string>
    <string name="notif_open">열기</string>
    <string name="notif_stop">중지</string>
    <string name="sleep_channel_name">수면</string>
    <string name="sleep_channel_description">수면 타이머와 소리가 실행되는 동안 표시돼요.</string>
    <string name="sleep_alarm_channel_name">알람</string>
    <string name="sleep_alarm_channel_description">수면 탭에서 설정한 기상 알람을 울려요.</string>
    <string name="sleep_notif_sleeping">수면 타이머 실행 중</string>
    <string name="sleep_notif_plus">+%1$d분</string>
    <string name="sleep_notif_alarm">알람</string>
    <string name="sleep_notif_snooze">다시 울림</string>
