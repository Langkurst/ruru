<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <!-- The notification that keeps Ruru running while the equaliser or the night schedule needs it. -->
    <string name="notif_channel_name">Ruru in the background</string>
    <string name="notif_channel_description">Shown while Ruru keeps the equaliser or your night schedule running.</string>
    <string name="notif_connected">Ruru is connected to %1$s</string>
    <string name="notif_waiting">Ruru is waiting for your headphones</string>
    <string name="notif_open">Open</string>
    <string name="notif_stop">Stop</string>
    <!-- The sleep timer's notification and the wake-up alarm's. -->
    <string name="sleep_channel_name">Sleep</string>
    <string name="sleep_channel_description">Shown while the sleep timer and its sounds run.</string>
    <string name="sleep_alarm_channel_name">Alarms</string>
    <string name="sleep_alarm_channel_description">Rings your wake-up alarms from the Sleep tab.</string>
    <string name="sleep_notif_sleeping">Sleep timer running</string>
    <string name="sleep_notif_plus">+%1$d min</string>
    <string name="sleep_notif_alarm">Alarm</string>
    <string name="sleep_notif_snooze">Snooze</string>
</resources>
