<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru im Hintergrund</string>
    <string name="notif_channel_description">Wird angezeigt, solange Ruru den Equalizer oder den Nachtplan am Laufen hält.</string>
    <string name="notif_connected">Ruru ist mit %1$s verbunden</string>
    <string name="notif_waiting">Ruru wartet auf die Kopfhörer</string>
    <string name="notif_open">Öffnen</string>
    <string name="notif_stop">Stopp</string>
    <string name="sleep_channel_name">Schlaf</string>
    <string name="sleep_channel_description">Wird angezeigt, solange der Schlaf-Timer und seine Klänge laufen.</string>
    <string name="sleep_alarm_channel_name">Wecker</string>
    <string name="sleep_alarm_channel_description">Lässt deine Wecker aus dem Schlaf-Tab klingeln.</string>
    <string name="sleep_notif_sleeping">Schlaf-Timer läuft</string>
    <string name="sleep_notif_plus">+%1$d Min</string>
    <string name="sleep_notif_alarm">Wecker</string>
    <string name="sleep_notif_snooze">Schlummern</string>
</resources>
