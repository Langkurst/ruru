<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru in background</string>
    <string name="notif_channel_description">Mostrata finché Ruru tiene attivi l\'equalizzatore o il programma notturno.</string>
    <string name="notif_connected">Ruru è connesso a %1$s</string>
    <string name="notif_waiting">Ruru aspetta le cuffie</string>
    <string name="notif_open">Apri</string>
    <string name="notif_stop">Ferma</string>
    <string name="sleep_channel_name">Sonno</string>
    <string name="sleep_channel_description">Mostrata mentre il timer del sonno e i suoi suoni sono in corso.</string>
    <string name="sleep_alarm_channel_name">Sveglie</string>
    <string name="sleep_alarm_channel_description">Fa suonare le tue sveglie dalla scheda Sonno.</string>
    <string name="sleep_notif_sleeping">Timer del sonno in corso</string>
    <string name="sleep_notif_plus">+%1$d min</string>
    <string name="sleep_notif_alarm">Sveglia</string>
    <string name="sleep_notif_snooze">Posticipa</string>
</resources>
