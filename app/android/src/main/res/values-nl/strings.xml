<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru op de achtergrond</string>
    <string name="notif_channel_description">Zichtbaar zolang Ruru de equalizer of het nachtschema draaiend houdt.</string>
    <string name="notif_connected">Ruru is verbonden met %1$s</string>
    <string name="notif_waiting">Ruru wacht op de koptelefoon</string>
    <string name="notif_open">Openen</string>
    <string name="notif_stop">Stoppen</string>
    <string name="sleep_channel_name">Slaap</string>
    <string name="sleep_channel_description">Zichtbaar zolang de slaaptimer en de geluiden lopen.</string>
    <string name="sleep_alarm_channel_name">Wekkers</string>
    <string name="sleep_alarm_channel_description">Laat je wekkers van het tabblad Slaap afgaan.</string>
    <string name="sleep_notif_sleeping">Slaaptimer loopt</string>
    <string name="sleep_notif_plus">+%1$d min</string>
    <string name="sleep_notif_alarm">Wekker</string>
    <string name="sleep_notif_snooze">Snoozen</string>
</resources>
