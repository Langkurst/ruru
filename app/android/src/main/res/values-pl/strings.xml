<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's name, the same in every language. Having this file in each language folder is what tells
         Android that Ruru speaks that language, so the system hands the app that locale (the screens' words
         come from the shared strings.xml, not from here). -->
    <string name="app_name" translatable="false">Ruru</string>
    <string name="notif_channel_name">Ruru w tle</string>
    <string name="notif_channel_description">Widoczne, gdy Ruru utrzymuje działanie korektora lub planu nocnego.</string>
    <string name="notif_connected">Ruru jest połączony z %1$s</string>
    <string name="notif_waiting">Ruru czeka na słuchawki</string>
    <string name="notif_open">Otwórz</string>
    <string name="notif_stop">Zatrzymaj</string>
    <string name="sleep_channel_name">Sen</string>
    <string name="sleep_channel_description">Widoczne, gdy działa timer snu i jego dźwięki.</string>
    <string name="sleep_alarm_channel_name">Budziki</string>
    <string name="sleep_alarm_channel_description">Dzwoni budzikami ustawionymi na karcie Sen.</string>
    <string name="sleep_notif_sleeping">Timer snu działa</string>
    <string name="sleep_notif_plus">+%1$d min</string>
    <string name="sleep_notif_alarm">Budzik</string>
    <string name="sleep_notif_snooze">Drzemka</string>
</resources>
