<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Ruru</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Ruru</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Ruru talks to your Bose headphones over Bluetooth to show and change their settings.</string>
    <!-- Candidate protocol names for Bose's accessory channel, unconfirmed. iOS hides accessories
         whose names aren't listed here, so the confirmed name (from the Bose app's own
         Info.plist) replaces these when someone finds it. -->
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.bose.bmap</string>
        <string>com.bose.protocol.bmap</string>
        <string>com.bose.ios.bmap</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>external-accessory</string>
    </array>
</dict>
</plist>
